{
    "name": "craigsimps/laravel-pdf-testing-demo",
    "description": "Minimal Laravel invoice demonstrating real PDF assertions.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "laravel/framework": "^12.70.2"
    },
    "require-dev": {
        "craigsimps/laravel-pdf-testing": "dev-milestone-3-release-readiness",
        "pestphp/pest": "3.8.6"
    },
    "repositories": [{
        "type": "path",
        "url": "../laravel-pdf-testing",
        "options": {
            "symlink": false,
            "versions": {"craigsimps/laravel-pdf-testing": "dev-milestone-3-release-readiness"}
        }
    }],
    "autoload": {"psr-4": {"App\\": "app/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "pest",
        "test:pdf": "pest --exclude-group=visual",
        "test:visual": "PDF_DEMO_VISUAL=1 pest --group=visual",
        "snapshot:update": "PDF_TESTING_UPDATE_SNAPSHOTS=1 PDF_DEMO_VISUAL=1 pest --group=visual"
    },
    "config": {
        "allow-plugins": {"pestphp/pest-plugin": true},
        "sort-packages": true,
        "platform": {"php": "8.3.0"}
    },
    "prefer-stable": true
}
