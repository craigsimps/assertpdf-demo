{
    "name": "craigsimps/assertpdf-demo",
    "description": "Minimal Laravel invoice demonstrating real PDF assertions.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "laravel/framework": "^12.70.2"
    },
    "require-dev": {
        "craigsimps/assertpdf": "^0.1",
        "pestphp/pest": "3.8.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "test:pdf": "pest --exclude-group=visual",
        "test:visual": "PDF_DEMO_VISUAL=1 pest --group=visual",
        "snapshot:update": "ASSERTPDF_UPDATE_SNAPSHOTS=1 PDF_DEMO_VISUAL=1 pest --group=visual"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "prefer-stable": true
}
